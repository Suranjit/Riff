{
  "name": "riffboard",
  "version": "0.1.1",
  "description": "Real-time collaborative brainstorming with coding agents. Host a shared board and riff on each other's Claude Code sessions.",
  "license": "MIT",
  "author": "Suranjit Adhikari and Riff contributors",
  "homepage": "https://github.com/Suranjit/Riff",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suranjit/Riff.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "brainstorming",
    "collaboration",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "riff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "board",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts start",
    "build": "tsup && node ./scripts/copy-board.mjs",
    "prepack": "pnpm --filter @riff/ui build && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "fastify": "^5.2.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@riff/mcp": "workspace:*",
    "@riff/server": "workspace:*",
    "@riff/shared": "workspace:*",
    "@riff/ui": "workspace:*",
    "tsup": "^8.3.5"
  }
}
